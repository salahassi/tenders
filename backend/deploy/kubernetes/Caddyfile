{
  admin off
  http_port 8080
  https_port 8443
  persist_config off
  log {
    level ERROR
  }
}

{$PUBLIC_HOST} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=86400"
  }
  reverse_proxy gateway:8080
}

http://:8082 {
  respond /healthz "ok" 200
}
