# Backend-only values for local development. Hosted secrets belong in private runtime storage.
APP_ALLOWED_ORIGINS=https://salahassi.github.io
# Public HTTPS API origin when SUPABASE_URL uses a private gateway. Leave empty for hosted Supabase.
APP_PUBLIC_API_URL=
APP_WORKER_SECRET=
FREE_ONLY=true
ALLOW_PAID_PROVIDERS=false
ENABLE_EXTERNAL_MESSAGES=false
ENABLE_PORTAL_PURCHASE=false
# Platform credentials are supplied by Supabase; never commit them.
# Model credentials remain deferred until the owner selects a provider.

# Optional local dispatcher settings. Hosted configuration uses private Vault-backed RPCs.
APP_COLLECTION_HOSTS=
# Empty host list is intentional until real sources and collection permission are reviewed.
